{
    "swagger": "2.0",
    "info": {
        "description": "API for JP Reader application.",
        "title": "JP Reader API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/v1",
    "paths": {
        "/healthz": {
            "get": {
                "description": "Returns 200 if the server is ready",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Checks if the server is ready",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/projects": {
            "get": {
                "description": "Retrieves all projects from the database",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "projects"
                ],
                "summary": "Get list of projects",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.Project"
                            }
                        }
                    },
                    "400": {
                        "description": "Couldn't get projects: [error message]",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/upload": {
            "post": {
                "description": "Uploads multiple files, saves them to a directory, creates a task record in the database, and sends the task to the queue",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "uploads"
                ],
                "summary": "Upload multiple files and queue task",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Title of the task",
                        "name": "title",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Files to upload",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Task has been queued",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Title is required / No files uploaded / Error retrieving file",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Error creating upload folder / Error saving file / Error copying file / Error creating task record / Error sending task to queue",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.Project": {
            "description": "Represents a project with its details.",
            "type": "object",
            "properties": {
                "ID": {
                    "type": "string"
                },
                "Images": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "Name": {
                    "type": "string"
                },
                "OcrData": {},
                "createdAt": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        }
    }
}